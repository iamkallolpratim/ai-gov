# Copy to .env and adjust. Docker Compose loads this file automatically.
#
# Every value here is a public development default. The application refuses to start in
# staging or production while any of them is still in place — set real secrets from your
# environment or secret manager instead.

# --- App ---
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true                # false gives human-readable console logs

# --- Authentication ---
# false (default): JWT required on every mutating endpoint, roles enforced.
# true:            no credentials required; every request runs as a system principal
#                  with the admin role. Only for a trusted private network. See the
#                  "Authentication modes" section of the README.
AUTH_DISABLED=false

# --- Security ---
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated, or a JSON array. Both forms are accepted.
CORS_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aigov
POSTGRES_PASSWORD=aigov
POSTGRES_DB=aigov

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Open Policy Agent ---
OPA_URL=http://localhost:8181
OPA_LOG_LEVEL=error

# --- S3-compatible storage (MinIO defaults) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=aigov-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# MinIO container credentials; the API reuses these as its S3 keys.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_EVIDENCE=20/hour
RATE_LIMIT_POLICY_CHECK=60/hour
# Defaults to REDIS_URL. Use memory:// for a single-process deployment.
# RATE_LIMIT_STORAGE_URI=

# --- Secure headers ---
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=63072000

# --- First-boot behaviour (docker/entrypoint.sh) ---
SEED_ON_START=true           # migrate + seed baseline data on container start
SYNC_OPA_ON_START=true       # push policies into OPA on container start

# Demo accounts are seeded only in local/test. To create them anywhere else you must opt
# in explicitly and set your own password.
# SEED_DEMO_USERS=false
# SEED_ADMIN_PASSWORD=

# --- Host port overrides (docker compose only) ---
# Uncomment if something already owns one of these ports.
# API_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# OPA_PORT=8181
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
