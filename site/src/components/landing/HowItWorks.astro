---
import { Image } from 'astro:assets';
import findings from '../../assets/console-findings.png';

const steps = [
  { n: '1', title: 'Register', body: 'Describe the system: purpose, use case, autonomy, data categories, and where it is deployed, offered and reachable.' },
  { n: '2', title: 'Detect', body: 'A pure rules engine decides which regimes apply and explains why, strictest first.' },
  { n: '3', title: 'Classify', body: 'A global baseline risk score, re-mapped through each regime. Overlays only escalate, never downgrade.' },
  { n: '4', title: 'Evaluate', body: 'Rego policies run in Open Policy Agent. Each finding cites the article it comes from and says how to fix it.' },
  { n: '5', title: 'Prove', body: 'One call produces a PDF report and a SHA-256-checksummed JSON manifest, stored in S3.' },
];

const rego = `violations contains v if {
    in_scope
    not base.flag("human_oversight_documented")
    v := base.violation(
        "eu.high_risk.art_14.human_oversight_missing",
        "Art. 14",
        "critical",
        "No human oversight measures are documented. ...",
        "Assign named oversight roles, document how reviewers
         interpret output and when they must intervene, ...",
    )
}`;

const finding = `{
  "policy_key": "eu_ai_act_high_risk",
  "jurisdiction_code": "EU",
  "result": "fail",
  "severity": "critical",
  "violations": [{
    "rule_id": "eu.high_risk.art_14.human_oversight_missing",
    "article": "Art. 14",
    "severity": "critical",
    "msg": "No human oversight measures are documented. ...",
    "remediation": "Assign named oversight roles, ..."
  }]
}`;
---

<section id="how" class="alt">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>From system metadata to cited findings</h2>
    <ol class="flow">
      {
        steps.map((s) => (
          <li class="card">
            <span class="n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="grid two pair">
      <div>
        <h3>The rule, in Rego</h3>
        <p class="cap"><code>policies/eu/eu_high_risk.rego</code> (excerpt)</p>
        <pre class="code"><code>{rego}</code></pre>
      </div>
      <div>
        <h3>The finding, in the API</h3>
        <p class="cap"><code>POST /api/v1/systems/&#123;id&#125;/check-policies</code> (abridged)</p>
        <pre class="code"><code>{finding}</code></pre>
      </div>
    </div>
    <figure class="shot">
      <Image
        src={findings}
        alt="A system's policy checks in the console: a failed EU AI Act transparency check citing Art. 53, with a How to fix box."
        widths={[640, 1024, 1440]}
        sizes="(max-width: 1120px) 100vw, 1120px"
      />
      <figcaption>Findings as a risk officer sees them in the console: article, severity, rule ID and the fix.</figcaption>
    </figure>
    <p class="after">
      Rules are plain files with unit tests (<code>opa test policies/</code>). A shared library handles
      laws that are not in force yet: <code>obligation()</code> reports a low-severity readiness
      finding until the effective date, then a real one, without a code change on the day.
    </p>
  </div>
</section>

<style>
  .flow {
    list-style: none;
    padding: 0;
    margin: 32px 0 48px;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 900px) {
    .flow {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .flow li {
    position: relative;
  }
  .n {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 10px;
  }
  @media (prefers-color-scheme: dark) {
    .n {
      color: #0c1626;
    }
  }
  .pair h3 {
    margin-bottom: 2px;
  }
  .cap {
    margin: 0 0 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .shot {
    margin: 40px 0 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  figcaption {
    font-size: 13px;
    color: var(--muted);
    margin-top: 8px;
  }
  .after {
    margin-top: 24px;
    color: var(--muted);
    max-width: 820px;
  }
</style>
