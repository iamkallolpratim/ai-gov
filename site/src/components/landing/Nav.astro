---
import { href, REPO_URL } from '../../lib/site';
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={href()}>
      <img src={href('favicon.svg')} alt="" width="26" height="26" />
      <span>AI Governance Console</span>
    </a>
    <nav aria-label="Main">
      <a href="#coverage">Coverage</a>
      <a href="#how">How it works</a>
      <a href="#quickstart">Quickstart</a>
      <a href={href('docs/')}>Docs</a>
      <a class="gh" href={REPO_URL}>GitHub</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 20px;
    font-size: 15px;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
  @media (max-width: 760px) {
    nav a:not(.gh):not([href$='docs/']) {
      display: none;
    }
    .brand span {
      font-size: 15px;
    }
  }
</style>
